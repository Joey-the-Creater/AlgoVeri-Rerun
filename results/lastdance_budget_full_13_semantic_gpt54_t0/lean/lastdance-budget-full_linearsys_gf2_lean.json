            "code": "import Mathlib\n\n-- Precondition definitions\n@[reducible, simp]\ndef solve_linear_system_gf2_precond (matrix : List (List Nat)) (b : List Nat) : Prop :=\n  -- !benchmark @start precond\n  matrix.length > 0 \u2227\n  (matrix.getD 0 []).length > 0 \u2227\n  matrix.length = b.length \u2227\n  matrix.length \u2264 100 \u2227\n  (matrix.getD 0 []).length \u2264 100 \u2227\n  (\u2200 row, row \u2208 matrix \u2192 (\u2200 x, x \u2208 row \u2192 x = 0 \u2228 x = 1)) \u2227\n  (\u2200 x, x \u2208 b \u2192 x = 0 \u2228 x = 1)\n  -- !benchmark @end precond\n\ndef is_solution (matrix : List (List Nat)) (b : List Nat) (x : List Nat) : Prop :=\n  x.length = (matrix.getD 0 []).length \u2227\n  (\u2200 i, i < matrix.length \u2192\n    ( (List.range x.length).foldl (fun acc j => acc + (matrix.getD i []).getD j 0 * x.getD j 0) 0 ) % 2 = b.getD i 0)\n\n-- !benchmark @start auxcode\ninstance decIsSolution (matrix : List (List Nat)) (b x : List Nat) :\n    Decidable (is_solution matrix b x) := by\n  unfold is_solution; infer_instance\n\nabbrev GRow : Type := List Bool \u00d7 Bool\n\ndef toB (v : Nat) : Bool := v == 1\ndef ofB (v : Bool) : Nat := if v then 1 else 0\n\ndef xorL : List Bool \u2192 List Bool \u2192 List Bool\n  | [], ys => ys\n  | xs, [] => xs\n  | x :: xs, y :: ys => (xor x y) :: xorL xs ys\n\ndef xorRow (r s : GRow) : GRow := (xorL r.1 s.1, xor r.2 s.2)\n\ndef dotB (k : Nat) (c x : List Bool) : Bool :=\n  match k with\n  | 0 => false\n  | k + 1 => xor (c.getD k false && x.getD k false) (dotB k c x)\n\ndef initRows (matrix : List (List Nat)) (b : List Nat) : List GRow :=\n  (List.range matrix.length).map\n    (fun i => ((matrix.getD i []).map toB, toB (b.getD i 0)))\n\ndef pickPivot (c : Nat) : List GRow \u2192 Option (GRow \u00d7 List GRow)\n  | [] => none\n  | r :: rs =>\n      if r.1.getD c false then some (r, rs)\n      else (pickPivot c rs).map (fun q => (q.1, r :: q.2))\n\ndef elim (n : Nat) (c : Nat) (rows : List GRow) (piv : List (Nat \u00d7 GRow)) :\n    List (Nat \u00d7 GRow) \u00d7 List GRow :=\n  if h : c < n then\n    match pickPivot c rows with\n    | none => elim n (c + 1) rows piv\n    | some (p, rest) =>\n        elim n (c + 1)\n          (rest.map (fun r => if r.1.getD c false then xorRow r p else r))\n          ((c, p) :: piv)\n  else (piv, rows)\ntermination_by n - c\ndecreasing_by all_goals omega\n\ndef backSub (n : Nat) : List (Nat \u00d7 GRow) \u2192 List Bool \u2192 List Bool\n  | [], x => x\n  | (c, p) :: ps, x => backSub n ps (x.set c (xor p.2 (dotB n p.1 x)))\n\ndef gaussCandidate (matrix : List (List Nat)) (b : List Nat) : List Nat :=\n  let n := (matrix.getD 0 []).length\n  let pr := elim n 0 (initRows matrix b) []\n  (backSub n pr.1 (List.replicate n false)).map ofB\n\ndef allVecs : Nat \u2192 List (List Nat)\n  | 0 => [[]]\n  | k + 1 => (allVecs k).flatMap (fun v => [0 :: v, 1 :: v])\n\ndef bruteForce (matrix : List (List Nat)) (b : List Nat) (n : Nat) :\n    Option (List Nat) :=\n  (allVecs n).find? (fun y => decide (is_solution matrix b y))\n-- !benchmark @end auxcode\n\n-- Main function definitions\ndef solve_linear_system_gf2 (matrix : List (List Nat)) (b : List Nat) (h_precond : solve_linear_system_gf2_precond matrix b) : Option (List Nat) :=\n  -- !benchmark @start code\n  let x := gaussCandidate matrix b\n  if is_solution matrix b x then some x\n  else bruteForce matrix b (matrix.getD 0 []).length\n  -- !benchmark @end code\n\n-- Postcondition definitions\n@[reducible, simp]\ndef solve_linear_system_gf2_postcond (matrix : List (List Nat)) (b : List Nat) (result : Option (List Nat)) (h_precond : solve_linear_system_gf2_precond matrix b) : Prop :=\n  -- !benchmark @start postcond\n  match result with\n  | some x => is_solution matrix b x\n  | none => \u2200 x, x.length = (matrix.getD 0 []).length \u2192 (\u2200 v, v \u2208 x \u2192 v = 0 \u2228 v = 1) \u2192 \u00ac is_solution matrix b x\n  -- !benchmark @end postcond\n\n-- !benchmark @start lemma\ntheorem mem_allVecs (x : List Nat) :\n    (\u2200 v \u2208 x, v = 0 \u2228 v = 1) \u2192 x \u2208 allVecs x.length := by\n  induction x with\n  | nil => simp [allVecs]\n  | cons a t ih =>\n      intro h\n      have ha : a = 0 \u2228 a = 1 := h a (by simp)\n      have ht : t \u2208 allVecs t.length := ih (fun v hv => h v (by simp [hv]))\n      simp only [List.length_cons, allVecs, List.mem_flatMap]\n      exact \u27e8t, ht, by rcases ha with rfl | rfl <;> simp\u27e9\n\ntheorem bruteForce_spec (matrix : List (List Nat)) (bb : List Nat) (n : Nat) :\n    match bruteForce matrix bb n with\n    | some y => is_solution matrix bb y\n    | none => \u2200 x, x.length = n \u2192 (\u2200 v \u2208 x, v = 0 \u2228 v = 1) \u2192\n        \u00ac is_solution matrix bb x := by\n  unfold bruteForce\n  cases hf : (allVecs n).find? (fun y => decide (is_solution matrix bb y)) with\n  | some y =>\n      have := List.find?_some hf\n      simpa using this\n  | none =>\n      intro x hlen h01 hsol\n      rw [List.find?_eq_none] at hf\n      have hmem : x \u2208 allVecs n := hlen \u25b8 mem_allVecs x h01\n      exact absurd (by simpa using hsol) (by simpa using hf x hmem)\n-- !benchmark @end lemma\n\n-- Proof content\ntheorem solve_linear_system_gf2_postcond_satisfied (matrix : List (List Nat)) (b : List Nat) (h_precond : solve_linear_system_gf2_precond matrix b) :\n    solve_linear_system_gf2_postcond matrix b (solve_linear_system_gf2 matrix b h_precond) h_precond := by\n  -- !benchmark @start proof\n  simp only [solve_linear_system_gf2_postcond, solve_linear_system_gf2]\n  by_cases hs : is_solution matrix b (gaussCandidate matrix b)\n  \u00b7 rw [if_pos hs]; exact hs\n  \u00b7 rw [if_neg hs]; exact bruteForce_spec matrix b (matrix.getD 0 []).length\n  -- !benchmark @end proof\n",
