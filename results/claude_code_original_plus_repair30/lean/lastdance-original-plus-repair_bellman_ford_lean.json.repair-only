    "rounds": 7,
    "llm_response": {
      "code": "import Mathlib\n\nstructure WeightedGraph where\n  adj : Array (Array (Nat \u00d7 Int))\n\ndef WeightedGraph.size (g : WeightedGraph) : Nat :=\n  g.adj.size\n\ndef WeightedGraph.has_edge (g : WeightedGraph) (u v : Nat) (w : Int) : Prop :=\n  u < g.size \u2227\n  \u2203 pair, pair \u2208 g.adj.getD u #[] \u2227 pair.1 = v \u2227 pair.2 = w\n\ndef WeightedGraph.well_formed (g : WeightedGraph) : Prop :=\n  \u2200 u, u < g.size \u2192\n    -- All targets in range\n    (\u2200 pair, pair \u2208 g.adj.getD u #[] \u2192 pair.1 < g.size) \u2227\n    -- Unique targets (simple graph)\n    (\u2200 p1 p2, p1 \u2208 g.adj.getD u #[] \u2192 p2 \u2208 g.adj.getD u #[] \u2192 p1.1 = p2.1 \u2192 p1 = p2)\n\ndef WeightedGraph.path_has_weight (g : WeightedGraph) (p : List Nat) (w_total : Int) : Prop :=\n  match p with\n  | [] => w_total = 0\n  | [_] => w_total = 0\n  | u :: v :: rest =>\n      \u2203 w_edge w_rest,\n        g.has_edge u v w_edge \u2227\n        g.path_has_weight (v :: rest) w_rest \u2227\n        w_total = w_edge + w_rest\n\ndef WeightedGraph.is_path (g : WeightedGraph) (p : List Nat) : Prop :=\n  p.length > 0 \u2227\n  match p with\n  | [] => True\n  | [_] => True\n  | u :: v :: rest =>\n      (\u2203 w, g.has_edge u v w) \u2227 g.is_path (v :: rest)\n\n-- Shortest path predicate\ndef WeightedGraph.is_shortest_dist (g : WeightedGraph) (start target : Nat) (d : Int) : Prop :=\n  (\u2203 p, g.is_path p \u2227 p.head? = some start \u2227 p.getLast? = some target \u2227 g.path_has_weight p d) \u2227\n  (\u2200 p w, g.is_path p \u2192 p.head? = some start \u2192 p.getLast? = some target \u2192 g.path_has_weight p w \u2192 w >= d)\n\n-- Negative cycle predicate\ndef WeightedGraph.has_negative_cycle (g : WeightedGraph) : Prop :=\n  \u2203 p w, g.is_path p \u2227 p.length > 1 \u2227 p.head? = p.getLast? \u2227 g.path_has_weight p w \u2227 w < 0\n\ndef WeightedGraph.weights_and_size_bounded (g : WeightedGraph) : Prop :=\n  g.size \u2264 100000 \u2227\n  \u2200 u v w, g.has_edge u v w \u2192 w \u2265 -100000 \u2227 w \u2264 100000\n\n-- Precondition definitions\n@[reducible, simp]\ndef bellman_ford_precond (graph : WeightedGraph) (start : Nat) : Prop :=\n  -- !benchmark @start precond\n  graph.well_formed \u2227\n  start < graph.size \u2227\n  graph.weights_and_size_bounded\n  -- !benchmark @end precond\n\n-- !benchmark @start auxcode\n\n/-! Distance vectors are functions `Nat \u2192 WithTop Int`, where `\u22a4` plays the role\nof `+\u221e` (unreachable).  Using `WithTop Int` gives us the usual ordered-monoid\narithmetic (`\u22a4 + a = \u22a4`, `a \u2264 \u22a4`) from Mathlib. -/\n\nabbrev BFD := Nat \u2192 WithTop Int\n\n/-- Convert an internal distance into the `Option Int` used by the specification. -/\ndef bfOut : WithTop Int \u2192 Option Int := fun x => WithTop.recTopCoe none (fun a => some a) x\n\n/-! The edge list of the graph, as triples `(source, target, weight)`. -/\n\ndef bfEdgesFrom (u : Nat) : List (Nat \u00d7 Int) \u2192 List (Nat \u00d7 Nat \u00d7 Int)\n  | [] => []\n  | pr :: rest => (u, pr.1, pr.2) :: bfEdgesFrom u rest\n\ndef bfEdgesUpto (g : WeightedGraph) : Nat \u2192 List (Nat \u00d7 Nat \u00d7 Int)\n  | 0 => []\n  | k + 1 => bfEdgesFrom k (g.adj.getD k #[]).toList ++ bfEdgesUpto g k\n\ndef bfAllEdges (g : WeightedGraph) : List (Nat \u00d7 Nat \u00d7 Int) := bfEdgesUpto g g.size\n\n/-- The value that edge `e` proposes for vertex `v` (`\u22a4` if `e` does not end at `v`). -/\ndef bfCand (f : BFD) (e : Nat \u00d7 Nat \u00d7 Int) (v : Nat) : WithTop Int :=\n  if e.2.1 = v then f e.1 + (e.2.2 : Int) else \u22a4\n\n/-- Relax every edge of `es` simultaneously, reading from `f`. -/\ndef bfStepAux (f : BFD) : List (Nat \u00d7 Nat \u00d7 Int) \u2192 Nat \u2192 WithTop Int\n  | [], v => f v\n  | e :: rest, v => min (bfCand f e v) (bfStepAux f rest v)\n\n/-- One full relaxation pass over all edges of the graph. -/\ndef bfStep (g : WeightedGraph) (f : BFD) : BFD := bfStepAux f (bfAllEdges g)\n\n/-- Initial distances: `0` at the source, `\u22a4` (unreachable) elsewhere. -/\ndef bfInitF (s : Nat) : BFD := fun v => if v = s then ((0 : Int) : WithTop Int) else \u22a4\n\n/-- `k` relaxation passes. -/\ndef bfIterF (g : WeightedGraph) (s : Nat) : Nat \u2192 BFD\n  | 0 => bfInitF s\n  | k + 1 => bfStep g (bfIterF g s k)\n\n/-- The distances of the first `n` vertices, as a list (used for the fixed-point test). -/\ndef bfVec (n : Nat) (f : BFD) : List (WithTop Int) := (List.range n).map f\n\n-- !benchmark @end auxcode\n\n-- Main function definition\ndef bellman_ford (graph : WeightedGraph) (start : Nat)\n    (h_precond : bellman_ford_precond graph start) : Option (List (Option Int)) :=\n  -- !benchmark @start code\n  if bfVec graph.size (bfStep graph (bfIterF graph start (graph.size - 1)))\n      = bfVec graph.size (bfIterF graph start (graph.size - 1)) then\n    some ((List.range graph.size).map (fun v => bfOut (bfIterF graph start (graph.size - 1) v)))\n  else\n    none\n  -- !benchmark @end code\n\n-- Postcondition definitions\n@[reducible, simp]\ndef bellman_ford_postcond (graph : WeightedGraph) (start : Nat)\n    (result : Option (List (Option Int)))\n    (_ : bellman_ford_precond graph start) : Prop :=\n  -- !benchmark @start postcond\n  match result with\n  | some dists =>\n      dists.length = graph.size \u2227\n      \u2200 v, v < graph.size \u2192\n        match dists.getD v none with\n        | some d => graph.is_shortest_dist start v d\n        | none => \u00ac \u2203 p, graph.is_path p \u2227 p.head? = some start \u2227 p.getLast? = some v\n  | none =>\n      graph.has_negative_cycle\n  -- !benchmark @end postcond\n\n-- !benchmark @start lemma\n\n/-! ### Basic unfolding lemmas for the specification predicates -/\n\nlemma bf_is_path_singleton (g : WeightedGraph) (x : Nat) : g.is_path [x] :=\n  \u27e8by simp, trivial\u27e9\n\nlemma bf_is_path_cc (g : WeightedGraph) (a b : Nat) (t : List Nat) :\n    g.is_path (a :: b :: t) \u2194 (\u2203 w, g.has_edge a b w) \u2227 g.is_path (b :: t) := by\n  constructor\n  \u00b7 intro h; exact h.2\n  \u00b7 intro h; exact \u27e8by simp, h\u27e9\n\nlemma bf_phw_cc (g : WeightedGraph) (a b : Nat) (t : List Nat) (w : Int) :\n    g.path_has_weight (a :: b :: t) w \u2194\n      \u2203 we wr, g.has_edge a b we \u2227 g.path_has_weight (b :: t) wr \u2227 w = we + wr := Iff.rfl\n\nlemma bf_phw_single (g : WeightedGraph) (a : Nat) (w : Int) :\n    g.path_has_weight [a] w \u2194 w = 0 := Iff.rfl\n\nlemma bf_has_weight (g : WeightedGraph) : \u2200 p : List Nat, g.is_path p \u2192 \u2203 w, g.path_has_weight p w := by\n  intro p\n  induction p with\n  | nil => intro h; exact \u27e80, rfl\u27e9\n  | cons a t ih =>\n    intro h\n    cases t with\n    | nil => exact \u27e80, rfl\u27e9\n    | cons b t' =>\n      rw [bf_is_path_cc] at h\n      obtain \u27e8\u27e8we, he\u27e9, hp\u27e9 := h\n      obtain \u27e8wr, hwr\u27e9 := ih hp\n      exact \u27e8we + wr, \u27e8we, wr, he, hwr, rfl\u27e9\u27e9\n\n/-! ### List helpers -/\n\nlemma bf_getLast_cons (a : Nat) (m : List Nat) (h : m \u2260 []) :\n    (a :: m).getLast? = m.getLast? := by\n  cases m with\n  | nil => exact absurd rfl h\n  | cons b t => simp\n\nlemma bf_getLast_app (l : List Nat) (hl : l \u2260 []) :\n    \u2200 A : List Nat, (A ++ l).getLast? = l.getLast? := by\n  intro A\n  induction A with\n  | nil => rw [List.nil_append]\n  | cons a A' ih =>\n    rw [List.cons_append, bf_getLast_cons a _ (by simp [hl])]\n    exact ih\n\nlemma bf_head_app (x : Nat) (C : List Nat) :\n    \u2200 A : List Nat, (A ++ x :: C).head? = (A ++ [x]).head? := by\n  intro A\n  cases A with\n  | nil => simp\n  | cons a A' => simp\n\nlemma bf_getD_map_range (n v : Nat) (f : Nat \u2192 Option Int) (hv : v < n) :\n    ((List.range n).map f).getD v none = f v := by\n  simp [List.getD_eq_getElem?_getD, hv]\n\n/-! ### Edge-list correctness -/\n\nlemma bf_mem_edgesFrom_of_mem {u : Nat} {l : List (Nat \u00d7 Int)} {pr : Nat \u00d7 Int} (h : pr \u2208 l) :\n    (u, pr.1, pr.2) \u2208 bfEdgesFrom u l := by\n  induction l with\n  | nil => cases h\n  | cons a t ih =>\n    rcases List.mem_cons.1 h with h1 | h1\n    \u00b7 subst h1; simp [bfEdgesFrom]\n    \u00b7 have := ih h1\n      simp [bfEdgesFrom]\n      exact Or.inr this\n\nlemma bf_edgesFrom_mem {u : Nat} {l : List (Nat \u00d7 Int)} {e : Nat \u00d7 Nat \u00d7 Int}\n    (h : e \u2208 bfEdgesFrom u l) : e.1 = u \u2227 (e.2.1, e.2.2) \u2208 l := by\n  induction l with\n  | nil => cases h\n  | cons a t ih =>\n    rw [bfEdgesFrom, List.mem_cons] at h\n    rcases h with h1 | h1\n    \u00b7 subst h1; exact \u27e8rfl, by simp\u27e9\n    \u00b7 obtain \u27e8h2, h3\u27e9 := ih h1\n      exact \u27e8h2, by simp [h3]\u27e9\n\nlemma bf_mem_edgesUpto {g : WeightedGraph} {k : Nat} {e : Nat \u00d7 Nat \u00d7 Int}\n    (h : e \u2208 bfEdgesUpto g k) :\n    e.1 < k \u2227 (e.2.1, e.2.2) \u2208 (g.adj.getD e.1 #[]).toList := by\n  induction k with\n  | zero => cases h\n  | succ k ih =>\n    rw [bfEdgesUpto, List.mem_append] at h\n    rcases h with h | h\n    \u00b7 obtain \u27e8h1, h2\u27e9 := bf_edgesFrom_mem h\n      subst h1\n      exact \u27e8Nat.lt_succ_self _, h2\u27e9\n    \u00b7 obtain \u27e8h1, h2\u27e9 := ih h\n      exact \u27e8Nat.lt_succ_of_lt h1, h2\u27e9\n\nlemma bf_mem_edgesUpto_of_lt {g : WeightedGraph} {u k : Nat} {e : Nat \u00d7 Nat \u00d7 Int}\n    (hu : u < k) (h : e \u2208 bfEdgesFrom u (g.adj.getD u #[]).toList) : e \u2208 bfEdgesUpto g k := by\n  induction k with\n  | zero => omega\n  | succ k ih =>\n    rw [bfEdgesUpto, List.mem_append]\n    rcases Nat.lt_succ_iff_lt_or_eq.1 hu with h1 | h1\n    \u00b7 exact Or.inr (ih h1)\n    \u00b7 subst h1; exact Or.inl h\n\nlemma bf_has_edge_of_mem {g : WeightedGraph} {u v : Nat} {w : Int}\n    (h : (u, v, w) \u2208 bfAllEdges g) : g.has_edge u v w := by\n  obtain \u27e8h1, h2\u27e9 := bf_mem_edgesUpto h\n  exact \u27e8h1, (v, w), by simpa using h2, rfl, rfl\u27e9\n\nlemma bf_mem_of_has_edge {g : WeightedGraph} {u v : Nat} {w : Int}\n    (h : g.has_edge u v w) : (u, v, w) \u2208 bfAllEdges g := by\n  obtain \u27e8hu, pr, hpr, hpr1, hpr2\u27e9 := h\n  have hm : (u, pr.1, pr.2) \u2208 bfEdgesFrom u (g.adj.getD u #[]).toList :=\n    bf_mem_edgesFrom_of_mem (by simpa using hpr)\n  rw [hpr1, hpr2] at hm\n  exact bf_mem_edgesUpto_of_lt hu hm\n\nlemma bf_target_lt {g : WeightedGraph} (hwf : g.well_formed) {u v : Nat} {w : Int}\n    (h : g.has_edge u v w) : v < g.size := by\n  obtain \u27e8hu, pr, hpr, h1, _\u27e9 := h\n  have := (hwf u hu).1 pr hpr\n  rw [h1] at this\n  exact this\n\n/-! ### The relaxation step -/\n\nlemma bf_stepAux_le_self (f : BFD) (es : List (Nat \u00d7 Nat \u00d7 Int)) (v : Nat) :\n    bfStepAux f es v \u2264 f v := by\n  induction es with\n  | nil => exact le_refl _\n  | cons e t ih => exact le_trans (min_le_right _ _) ih\n\nlemma bf_stepAux_le_edge (f : BFD) (es : List (Nat \u00d7 Nat \u00d7 Int)) (v : Nat)\n    {e : Nat \u00d7 Nat \u00d7 Int} (he : e \u2208 es) (hv : e.2.1 = v) :\n    bfStepAux f es v \u2264 f e.1 + (e.2.2 : Int) := by\n  induction es with\n  | nil => cases he\n  | cons a t ih =>\n    rcases List.mem_cons.1 he with h1 | h1\n    \u00b7 subst h1\n      refine le_trans (min_le_left _ _) ?_\n      simp [bfCand, hv]\n    \u00b7 exact le_trans (min_le_right _ _) (ih h1)\n\nlemma bf_stepAux_spec (f : BFD) (es : List (Nat \u00d7 Nat \u00d7 Int)) (v : Nat) :\n    bfStepAux f es v = f v \u2228\n      \u2203 e \u2208 es, e.2.1 = v \u2227 bfStepAux f es v = f e.1 + (e.2.2 : Int) := by\n  induction es with\n  | nil => exact Or.inl rfl\n  | cons a t ih =>\n    by_cases hav : a.2.1 = v\n    \u00b7 have hc : bfStepAux f (a :: t) v = min (f a.1 + (a.2.2 : Int)) (bfStepAux f t v) := by\n        simp only [bfStepAux, bfCand, if_pos hav]\n      rcases le_total (f a.1 + (a.2.2 : Int)) (bfStepAux f t v) with h | h\n      \u00b7 exact Or.inr \u27e8a, by simp, hav, by rw [hc, min_eq_left h]\u27e9\n      \u00b7 rw [hc, min_eq_right h]\n        rcases ih with ih | \u27e8e, he, he1, he2\u27e9\n        \u00b7 exact Or.inl ih\n        \u00b7 exact Or.inr \u27e8e, by simp [he], he1, he2\u27e9\n    \u00b7 have hc : bfStepAux f (a :: t) v = bfStepAux f t v := by\n        simp only [bfStepAux, bfCand, if_neg hav]\n        exact min_eq_right le_top\n      rw [hc]\n      rcases ih with ih | \u27e8e, he, he1, he2\u27e9\n      \u00b7 exact Or.inl ih\n      \u00b7 exact Or.inr \u27e8e, by simp [he], he1, he2\u27e9\n\nlemma bf_step_le_self (g : WeightedGraph) (f : BFD) (v : Nat) : bfStep g f v \u2264 f v :=\n  bf_stepAux_le_self f _ v\n\nlemma bf_step_le_edge (g : WeightedGraph) (f : BFD) {u v : Nat} {w : Int}\n    (h : g.has_edge u v w) : bfStep g f v \u2264 f u + (w : Int) :=\n  bf_stepAux_le_edge f _ v (bf_mem_of_has_edge h) rfl\n\nlemma bf_step_spec (g : WeightedGraph) (f : BFD) (v : Nat) :\n    bfStep g f v = f v \u2228 \u2203 u w, g.has_edge u v w \u2227 bfStep g f v = f u + (w : Int) := by\n  rcases bf_stepAux_spec f (bfAllEdges g) v with h | \u27e8e, he, he1, he2\u27e9\n  \u00b7 exact Or.inl h\n  \u00b7 refine Or.inr \u27e8e.1, e.2.2, ?_, he2\u27e9\n    have hh : g.has_edge e.1 e.2.1 e.2.2 := bf_has_edge_of_mem (by simpa using he)\n    rw [he1] at hh\n    exact hh\n\nlemma bf_mono (g : WeightedGraph) (s : Nat) :\n    \u2200 (k j v : Nat), j \u2264 k \u2192 bfIterF g s k v \u2264 bfIterF g s j v := by\n  intro k\n  induction k with\n  | zero => intro j v hj; interval_cases j; exact le_refl _\n  | succ k ih =>\n    intro j v hj\n    rcases Nat.lt_succ_iff_lt_or_eq.1 (Nat.lt_succ_of_le hj) with h | h\n    \u00b7 exact le_trans (bf_step_le_self g _ v) (ih j v (by omega))\n    \u00b7 subst h; exact le_refl _\n\n/-! ### Concatenation lemmas for walks -/\n\nlemma bf_split (g : WeightedGraph) (x : Nat) (B : List Nat) :\n    \u2200 A : List Nat, g.is_path (A ++ x :: B) \u2194 g.is_path (A ++ [x]) \u2227 g.is_path (x :: B) := by\n  intro A\n  induction A with\n  | nil => simp [bf_is_path_singleton g x]\n  | cons a A ih =>\n    cases A with\n    | nil =>\n      simp only [List.cons_append, List.nil_append]\n      rw [bf_is_path_cc, bf_is_path_cc]\n      simp [bf_is_path_singleton g x]\n    | cons a' A' =>\n      simp only [List.cons_append] at *\n      rw [bf_is_path_cc, bf_is_path_cc, ih]\n      tauto\n\nlemma bf_split_w (g : WeightedGraph) (x : Nat) (B : List Nat) :\n    \u2200 (A : List Nat) (w : Int), g.path_has_weight (A ++ x :: B) w \u2194\n      \u2203 w1 w2, g.path_has_weight (A ++ [x]) w1 \u2227 g.path_has_weight (x :: B) w2 \u2227 w = w1 + w2 := by\n  intro A\n  induction A with\n  | nil =>\n    intro w\n    simp only [List.nil_append]\n    constructor\n    \u00b7 intro h; exact \u27e80, w, rfl, h, by ring\u27e9\n    \u00b7 rintro \u27e8w1, w2, h1, h2, rfl\u27e9\n      rw [bf_phw_single] at h1\n      subst h1\n      simpa using h2\n  | cons a A ih =>\n    intro w\n    cases A with\n    | nil =>\n      simp only [List.cons_append, List.nil_append]\n      rw [bf_phw_cc, bf_phw_cc]\n      constructor\n      \u00b7 rintro \u27e8we, wr, he, hr, rfl\u27e9\n        exact \u27e8we, wr, \u27e8we, 0, he, rfl, by ring\u27e9, hr, rfl\u27e9\n      \u00b7 rintro \u27e8w1, w2, \u27e8we, wr, he, hr, rfl\u27e9, h2, rfl\u27e9\n        rw [bf_phw_single] at hr\n        subst hr\n        exact \u27e8we, w2, he, h2, by ring\u27e9\n    | cons a' A' =>\n      simp only [List.cons_append] at *\n      rw [bf_phw_cc, bf_phw_cc]\n      constructor\n      \u00b7 rintro \u27e8we, wr, he, hr, rfl\u27e9\n        rw [ih] at hr\n        obtain \u27e8w1, w2, h1, h2, rfl\u27e9 := hr\n        exact \u27e8we + w1, w2, \u27e8we, w1, he, h1, rfl\u27e9, h2, by ring\u27e9\n      \u00b7 rintro \u27e8w1, w2, \u27e8we, wr, he, hr, rfl\u27e9, h2, rfl\u27e9\n        refine \u27e8we, wr + w2, he, ?_, by ring\u27e9\n        rw [ih]\n        exact \u27e8wr, w2, hr, h2, rfl\u27e9\n\nlemma bf_snoc (g : WeightedGraph) (v : Nat) :\n    \u2200 (p : List Nat) (u : Nat) (a we : Int),\n      g.is_path p \u2192 p.getLast? = some u \u2192 g.path_has_weight p a \u2192 g.has_edge u v we \u2192\n      g.is_path (p ++ [v]) \u2227 g.path_has_weight (p ++ [v]) (a + we) := by\n  intro p\n  induction p with\n  | nil => intro u a we _ hl _ _; simp at hl\n  | cons b t ih =>\n    intro u a we hp hl hw he\n    cases t with\n    | nil =>\n      simp at hl\n      subst hl\n      rw [bf_phw_single] at hw\n      subst hw\n      refine \u27e8?_, ?_\u27e9\n      \u00b7 rw [List.cons_append, List.nil_append, bf_is_path_cc]\n        exact \u27e8\u27e8we, he\u27e9, bf_is_path_singleton g v\u27e9\n      \u00b7 rw [List.cons_append, List.nil_append, bf_phw_cc]\n        exact \u27e8we, 0, he, rfl, by ring\u27e9\n    | cons c t' =>\n      rw [bf_is_path_cc] at hp\n      rw [bf_phw_cc] at hw\n      obtain \u27e8\u27e8w0, he0\u27e9, hp'\u27e9 := hp\n      obtain \u27e8we1, wr, he1, hwr, rfl\u27e9 := hw\n      have hl' : (c :: t').getLast? = some u := by simpa using hl\n      obtain \u27e8ih1, ih2\u27e9 := ih u wr we hp' hl' hwr he\n      refine \u27e8?_, ?_\u27e9\n      \u00b7 rw [List.cons_append, bf_is_path_cc]\n        exact \u27e8\u27e8we1, he1\u27e9, ih1\u27e9\n      \u00b7 rw [List.cons_append, bf_phw_cc]\n        exact \u27e8we1, wr + we, he1, ih2, by ring\u27e9\n\n/-! ### Soundness and completeness of the iteration -/\n\nlemma bf_sound (g : WeightedGraph) (s : Nat) :\n    \u2200 (k v : Nat) (x : Int), bfIterF g s k v = ((x : Int) : WithTop Int) \u2192\n      \u2203 p, g.is_path p \u2227 p.head? = some s \u2227 p.getLast? = some v \u2227 g.path_has_weight p x := by\n  intro k\n  induction k with\n  | zero =>\n    intro v x hx\n    by_cases hv : v = s\n    \u00b7 subst hv\n      have : ((0 : Int) : WithTop Int) = ((x : Int) : WithTop Int) := by\n        rw [\u2190 hx]; simp [bfIterF, bfInitF]\n      have hx0 : x = 0 := by\n        have := WithTop.coe_eq_coe.1 this\n        omega\n      subst hx0\n      exact \u27e8[v], bf_is_path_singleton g v, by simp, by simp, rfl\u27e9\n    \u00b7 exfalso\n      have : (\u22a4 : WithTop Int) = ((x : Int) : WithTop Int) := by\n        rw [\u2190 hx]; simp [bfIterF, bfInitF, hv]\n      exact (WithTop.coe_ne_top this.symm)\n  | succ k ih =>\n    intro v x hx\n    rcases bf_step_spec g (bfIterF g s k) v with h | \u27e8u, we, he, h\u27e9\n    \u00b7 exact ih v x (by rw [show bfIterF g s (k+1) v = bfStep g (bfIterF g s k) v from rfl, h] at hx; exact hx)\n    \u00b7 have hx' : bfIterF g s k u + ((we : Int) : WithTop Int) = ((x : Int) : WithTop Int) := by\n        rw [\u2190 h]; exact hx\n      rcases eq_or_ne (bfIterF g s k u) \u22a4 with hu | hu\n      \u00b7 exfalso\n        rw [hu, top_add] at hx'\n        exact WithTop.coe_ne_top hx'.symm\n      \u00b7 obtain \u27e8a, ha\u27e9 := WithTop.ne_top_iff_exists.1 hu\n        have hax : a + we = x := by\n          rw [\u2190 ha] at hx'\n          rw [\u2190 WithTop.coe_add] at hx'\n          exact WithTop.coe_eq_coe.1 hx'\n        obtain \u27e8p, hp, hph, hpl, hpw\u27e9 := ih u a ha.symm\n        obtain \u27e8h1, h2\u27e9 := bf_snoc g v p u a we hp hpl hpw he\n        refine \u27e8p ++ [v], h1, ?_, ?_, ?_\u27e9\n        \u00b7 cases p with\n          | nil => simp at hph\n          | cons b t => simpa using hph\n        \u00b7 rw [bf_getLast_app [v] (by simp) p]; simp\n        \u00b7 rw [hax] at h2; exact h2\n\nlemma bf_complete (g : WeightedGraph) (s : Nat) :\n    \u2200 (n : Nat) (p : List Nat) (a v : Nat) (w : Int),\n      g.is_path p \u2192 p.head? = some a \u2192 p.getLast? = some v \u2192 g.path_has_weight p w \u2192\n      p.length = n + 1 \u2192\n      \u2200 j, bfIterF g s (j + n) v \u2264 bfIterF g s j a + ((w : Int) : WithTop Int) := by\n  intro n\n  induction n with\n  | zero =>\n    intro p a v w _ hh hl hw hlen j\n    obtain \u27e8b, rfl\u27e9 := List.length_eq_one_iff.1 hlen\n    have hba : b = a := by simpa using hh\n    have hbv : b = v := by simpa using hl\n    rw [bf_phw_single] at hw\n    subst hba; subst hbv; subst hw\n    simp\n  | succ n ih =>\n    intro p a v w hp hh hl hw hlen j\n    cases p with\n    | nil => simp at hlen\n    | cons b t =>\n      have hba : b = a := by simpa using hh\n      subst hba\n      cases t with\n      | nil => simp at hlen\n      | cons c t' =>\n        rw [bf_is_path_cc] at hp\n        rw [bf_phw_cc] at hw\n        obtain \u27e8_, hp'\u27e9 := hp\n        obtain \u27e8we, wr, he, hwr, rfl\u27e9 := hw\n        have hl' : (c :: t').getLast? = some v := by simpa using hl\n        have hlen' : (c :: t').length = n + 1 := by simpa using hlen\n        have h1 : bfIterF g s ((j + 1) + n) v \u2264 bfIterF g s (j + 1) c + ((wr : Int) : WithTop Int) :=\n          ih (c :: t') c v wr hp' (by simp) hl' hwr hlen' (j + 1)\n        have h2 : bfIterF g s (j + 1) c \u2264 bfIterF g s j b + ((we : Int) : WithTop Int) :=\n          bf_step_le_edge g (bfIterF g s j) he\n        have h3 : bfIterF g s (j + 1) c + ((wr : Int) : WithTop Int)\n            \u2264 (bfIterF g s j b + ((we : Int) : WithTop Int)) + ((wr : Int) : WithTop Int) :=\n          add_le_add_right h2 _\n        have h4 : bfIterF g s ((j + 1) + n) v\n            \u2264 bfIterF g s j b + (((we + wr : Int) : WithTop Int)) := by\n          refine le_trans (le_trans h1 h3) ?_\n          rw [WithTop.coe_add, add_assoc]\n        have hidx : j + (n + 1) = (j + 1) + n := by omega\n        rw [hidx]\n        exact h4\n\n/-! ### Reachable vertices are in range; cycle removal -/\n\nlemma bf_mem_lt (g : WeightedGraph) (hwf : g.well_formed) :\n    \u2200 (p : List Nat) (a : Nat), g.is_path p \u2192 p.head? = some a \u2192 a < g.size \u2192\n      \u2200 y \u2208 p, y < g.size := by\n  intro p\n  induction p with\n  | nil => intro a _ _ _ y hy; cases hy\n  | cons b t ih =>\n    intro a hp hh ha y hy\n    have hba : b = a := by simpa using hh\n    subst hba\n    rcases List.mem_cons.1 hy with h1 | h1\n    \u00b7 subst h1; exact ha\n    \u00b7 cases t with\n      | nil => cases h1\n      | cons c t' =>\n        rw [bf_is_path_cc] at hp\n        obtain \u27e8\u27e8w0, he0\u27e9, hp'\u27e9 := hp\n        exact ih c hp' (by simp) (bf_target_lt hwf he0) y h1\n\nlemma bf_dup_split : \u2200 p : List Nat, \u00ac p.Nodup \u2192\n    \u2203 (A B C : List Nat) (x : Nat), p = A ++ x :: (B ++ x :: C) := by\n  intro p\n  induction p with\n  | nil => intro h; exact absurd List.nodup_nil h\n  | cons a t ih =>\n    intro h\n    by_cases hat : a \u2208 t\n    \u00b7 obtain \u27e8B, C, hBC\u27e9 := List.append_of_mem hat\n      exact \u27e8[], B, C, a, by rw [hBC]\u27e9\n    \u00b7 have ht : \u00ac t.Nodup := fun hnd => h (List.nodup_cons.2 \u27e8hat, hnd\u27e9)\n      obtain \u27e8A, B, C, x, hx\u27e9 := ih ht\n      exact \u27e8a :: A, B, C, x, by rw [hx]; rfl\u27e9\n\nlemma bf_not_nodup (g : WeightedGraph) (p : List Nat)\n    (hmem : \u2200 y \u2208 p, y < g.size) (hlen : g.size < p.length) : \u00ac p.Nodup := by\n  intro hnd\n  have h1 : p.toFinset \u2286 Finset.range g.size := by\n    intro y hy\n    rw [List.mem_toFinset] at hy\n    rw [Finset.mem_range]\n    exact hmem y hy\n  have h2 : p.toFinset.card \u2264 g.size := by\n    have := Finset.card_le_card h1\n    simpa using this\n  have h3 : p.toFinset.card = p.length := List.toFinset_card_of_nodup hnd\n  omega\n\nlemma bf_shorten (g : WeightedGraph) (hwf : g.well_formed) (hnc : \u00ac g.has_negative_cycle)\n    (s : Nat) (hs : s < g.size) :\n    \u2200 (n : Nat) (p : List Nat) (v : Nat) (w : Int), p.length \u2264 n \u2192\n      g.is_path p \u2192 p.head? = some s \u2192 p.getLast? = some v \u2192 g.path_has_weight p w \u2192\n      \u2203 (q : List Nat) (w' : Int), g.is_path q \u2227 q.head? = some s \u2227 q.getLast? = some v \u2227\n        g.path_has_weight q w' \u2227 w' \u2264 w \u2227 q.length \u2264 g.size := by\n  intro n\n  induction n with\n  | zero =>\n    intro p v w hlen _ hh _ _\n    exfalso\n    have : p = [] := List.eq_nil_of_length_eq_zero (by omega)\n    subst this\n    simp at hh\n  | succ n ih =>\n    intro p v w hlen hp hh hl hw\n    by_cases hsz : p.length \u2264 g.size\n    \u00b7 exact \u27e8p, w, hp, hh, hl, hw, le_refl _, hsz\u27e9\n    \u00b7 push_neg at hsz\n      have hmem := bf_mem_lt g hwf p s hp hh hs\n      have hnd := bf_not_nodup g p hmem hsz\n      obtain \u27e8A, B, C, x, rfl\u27e9 := bf_dup_split _ hnd\n      -- split off the prefix A\n      have hs1 := (bf_split g x (B ++ x :: C) A).1 hp\n      obtain \u27e8w1, w2, hw1, hw2, hweq\u27e9 := (bf_split_w g x (B ++ x :: C) A w).1 hw\n      have hrw : x :: (B ++ x :: C) = (x :: B) ++ x :: C := by simp\n      rw [hrw] at hs1 hw2\n      -- split the remainder into the cycle and the tail\n      have hs2 := (bf_split g x C (x :: B)).1 hs1.2\n      obtain \u27e8w3, w4, hw3, hw4, hw2eq\u27e9 := (bf_split_w g x C (x :: B) w2).1 hw2\n      -- the cycle has nonnegative weight\n      have hcyc : (0 : Int) \u2264 w3 := by\n        by_contra hlt\n        push_neg at hlt\n        refine hnc \u27e8(x :: B) ++ [x], w3, hs2.1, ?_, ?_, hw3, hlt\u27e9\n        \u00b7 simp\n        \u00b7 simp\n      -- the shortcut\n      have hq0p : g.is_path (A ++ x :: C) := (bf_split g x C A).2 \u27e8hs1.1, hs2.2\u27e9\n      have hq0w : g.path_has_weight (A ++ x :: C) (w1 + w4) :=\n        (bf_split_w g x C A (w1 + w4)).2 \u27e8w1, w4, hw1, hw4, rfl\u27e9\n      have hq0h : (A ++ x :: C).head? = some s := by\n        rw [bf_head_app x C A]\n        rw [bf_head_app x (B ++ x :: C) A] at hh\n        exact hh\n      have hq0l : (A ++ x :: C).getLast? = some v := by\n        rw [bf_getLast_app (x :: C) (by simp) A]\n        have hp2 : A ++ x :: (B ++ x :: C) = (A ++ x :: B) ++ (x :: C) := by simp\n        rw [hp2, bf_getLast_app (x :: C) (by simp)] at hl\n        exact hl\n      have hlt : (A ++ x :: C).length \u2264 n := by\n        simp only [List.length_append, List.length_cons] at hlen \u22a2\n        omega\n      obtain \u27e8q, w', hq1, hq2, hq3, hq4, hq5, hq6\u27e9 :=\n        ih (A ++ x :: C) v (w1 + w4) hlt hq0p hq0h hq0l hq0w\n      exact \u27e8q, w', hq1, hq2, hq3, hq4, by omega, hq6\u27e9\n\n/-! ### The fixed-point bound -/\n\nlemma bf_fix_bound (g : WeightedGraph) (f : BFD)\n    (hle : \u2200 u v w, g.has_edge u v w \u2192 f v \u2264 f u + ((w : Int) : WithTop Int)) :\n    \u2200 (p : List Nat) (a v : Nat) (w : Int),\n      g.is_path p \u2192 p.head? = some a \u2192 p.getLast? = some v \u2192 g.path_has_weight p w \u2192\n      f v \u2264 f a + ((w : Int) : WithTop Int) := by\n  intro p\n  induction p with\n  | nil => intro a v w _ hh _ _; simp at hh\n  | cons b t ih =>\n    intro a v w hp hh hl hw\n    have hba : b = a := by simpa using hh\n    subst hba\n    cases t with\n    | nil =>\n      have hbv : b = v := by simpa using hl\n      rw [bf_phw_single] at hw\n      subst hbv; subst hw\n      simp\n    | cons c t' =>\n      rw [bf_is_path_cc] at hp\n      rw [bf_phw_cc] at hw\n      obtain \u27e8_, hp'\u27e9 := hp\n      obtain \u27e8we, wr, he, hwr, rfl\u27e9 := hw\n      have hl' : (c :: t').getLast? = some v := by simpa using hl\n      have h1 : f v \u2264 f c + ((wr : Int) : WithTop Int) := ih c v wr hp' (by simp) hl' hwr\n      have h2 : f c \u2264 f b + ((we : Int) : WithTop Int) := hle b c we he\n      have h3 := add_le_add_right h2 (((wr : Int) : WithTop Int))\n      refine le_trans (le_trans h1 h3) ?_\n      rw [WithTop.coe_add, add_assoc]\n\nlemma bf_vec_eq_iff (n : Nat) (f h : BFD) :\n    bfVec n f = bfVec n h \u2194 \u2200 v, v < n \u2192 f v = h v := by\n  constructor\n  \u00b7 intro hh v hv\n    have hg : (bfVec n f)[v]? = (bfVec n h)[v]? := by rw [hh]\n    simpa [bfVec, hv] using hg\n  \u00b7 intro hh\n    simp only [bfVec]\n    exact List.map_congr_left (fun v hv => hh v (List.mem_range.1 hv))\n\n-- !benchmark @end lemma\n\n-- Proof content\ntheorem bellman_ford_postcond_satisfied (graph : WeightedGraph) (start : Nat)\n    (h_precond : bellman_ford_precond graph start) :\n    bellman_ford_postcond graph start\n      (bellman_ford graph start h_precond) h_precond := by\n  -- !benchmark @start proof\n  obtain \u27e8hwf, hstart, _hb\u27e9 := h_precond\n  set F : BFD := bfIterF graph start (graph.size - 1) with hF\n  have hsize : graph.size - 1 + 1 = graph.size := by omega\n  unfold bellman_ford\n  split_ifs with hfix\n  \u00b7 -- fixed point reached: the distances are correct\n    rw [\u2190 hF] at hfix\n    have hpt : \u2200 v, v < graph.size \u2192 bfStep graph F v = F v :=\n      (bf_vec_eq_iff graph.size (bfStep graph F) F).1 hfix\n    have hle : \u2200 u v w, graph.has_edge u v w \u2192 F v \u2264 F u + ((w : Int) : WithTop Int) := by\n      intro u v w he\n      have hv : v < graph.size := bf_target_lt hwf he\n      rw [\u2190 hpt v hv]\n      exact bf_step_le_edge graph F he\n    have hFs : F start \u2264 ((0 : Int) : WithTop Int) := by\n      have h0 : bfIterF graph start 0 start = ((0 : Int) : WithTop Int) := by\n        simp [bfIterF, bfInitF]\n      rw [hF, \u2190 h0]\n      exact bf_mono graph start (graph.size - 1) 0 start (Nat.zero_le _)\n    have hbound : \u2200 (p : List Nat) (v : Nat) (w : Int), graph.is_path p \u2192 p.head? = some start \u2192\n        p.getLast? = some v \u2192 graph.path_has_weight p w \u2192 F v \u2264 ((w : Int) : WithTop Int) := by\n      intro p v w hp hh hl hw\n      have h1 := bf_fix_bound graph F hle p start v w hp hh hl hw\n      refine le_trans h1 ?_\n      have h2 := add_le_add_right hFs (((w : Int) : WithTop Int))\n      simpa using h2\n    refine \u27e8by simp, ?_\u27e9\n    intro v hv\n    rw [bf_getD_map_range graph.size v (fun v => bfOut (F v)) hv]\n    rcases eq_or_ne (F v) \u22a4 with hFv | hFv\n    \u00b7 rw [hFv]\n      show \u00ac \u2203 p, graph.is_path p \u2227 p.head? = some start \u2227 p.getLast? = some v\n      rintro \u27e8p, hp, hh, hl\u27e9\n      obtain \u27e8w, hw\u27e9 := bf_has_weight graph p hp\n      have := hbound p v w hp hh hl hw\n      rw [hFv] at this\n      exact absurd (top_le_iff.1 this) (WithTop.coe_ne_top)\n    \u00b7 obtain \u27e8x, hx\u27e9 := WithTop.ne_top_iff_exists.1 hFv\n      rw [\u2190 hx]\n      show graph.is_shortest_dist start v x\n      refine \u27e8bf_sound graph start (graph.size - 1) v x hx.symm, ?_\u27e9\n      intro p w hp hh hl hw\n      have h1 := hbound p v w hp hh hl hw\n      rw [\u2190 hx] at h1\n      exact WithTop.coe_le_coe.1 h1\n  \u00b7 -- an edge can still be relaxed after |V|-1 passes: a negative cycle exists\n    rw [\u2190 hF] at hfix\n    show graph.has_negative_cycle\n    by_contra hnc\n    apply hfix\n    rw [bf_vec_eq_iff]\n    intro v hv\n    by_contra hne\n    have hlt : bfStep graph F v < F v := lt_of_le_of_ne (bf_step_le_self graph F v) hne\n    rcases bf_step_spec graph F v with h | \u27e8u, we, he, h\u27e9\n    \u00b7 exact hne h\n    \u00b7 rw [h] at hlt\n      rcases eq_or_ne (F u) \u22a4 with hu | hu\n      \u00b7 rw [hu, top_add] at hlt\n        exact not_top_lt hlt\n      obtain \u27e8a, ha\u27e9 := WithTop.ne_top_iff_exists.1 hu\n      obtain \u27e8P, hP, hPh, hPl, hPw\u27e9 := bf_sound graph start (graph.size - 1) u a ha.symm\n      obtain \u27e8h1, h2\u27e9 := bf_snoc graph v P u a we hP hPl hPw he\n      have hPh' : (P ++ [v]).head? = some start := by\n        cases P with\n        | nil => simp at hPh\n        | cons b t => simpa using hPh\n      have hPl' : (P ++ [v]).getLast? = some v := by\n        rw [bf_getLast_app [v] (by simp) P]; simp\n      obtain \u27e8q, w', hq1, hq2, hq3, hq4, hq5, hq6\u27e9 :=\n        bf_shorten graph hwf hnc start hstart (P ++ [v]).length (P ++ [v]) v (a + we)\n          (le_refl _) h1 hPh' hPl' h2\n      have hqne : q \u2260 [] := by intro hc; rw [hc] at hq2; simp at hq2\n      have hqlen : q.length = (q.length - 1) + 1 := by\n        cases q with\n        | nil => exact absurd rfl hqne\n        | cons b t => simp\n      have hc1 := bf_complete graph start (q.length - 1) q start v w' hq1 hq2 hq3 hq4 hqlen 0\n      have hc2 : bfIterF graph start 0 start = ((0 : Int) : WithTop Int) := by\n        simp [bfIterF, bfInitF]\n      rw [hc2, zero_add, Nat.zero_add] at hc1\n      have hc3 : F v \u2264 ((w' : Int) : WithTop Int) :=\n        le_trans (bf_mono graph start (graph.size - 1) (q.length - 1) v (by omega)) hc1\n      have hkey : ((a + we : Int) : WithTop Int) < F v := by\n        rw [WithTop.coe_add, \u2190 ha]; exact hlt\n      have hw'le : ((w' : Int) : WithTop Int) \u2264 ((a + we : Int) : WithTop Int) :=\n        WithTop.coe_le_coe.2 hq5\n      exact absurd (lt_of_lt_of_le (lt_of_lt_of_le hkey hc3) hw'le) (lt_irrefl _)\n  -- !benchmark @end proof\n",
